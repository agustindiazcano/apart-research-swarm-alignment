# Variable NAMES only. Copy to .env (git-ignored) and fill in locally. Never commit values.
# Model IDs, regions, prices and spend caps go in experiment configs, not here.
# Providers used by this project: Adaption (Apart Research credits), Meta Muse, Google Vertex AI.
# Reference for how each provider is called: ../software-ai-eval (docs/MODELS.md, config/models.example.yaml).

# Adaption (Apart Research credits). Responses API through the `adaption` SDK.
ADAPTION_API_KEY=

# Google Vertex AI (Gemini). Authentication uses Application Default Credentials
# (gcloud auth application-default login), so no key goes here.
# GOOGLE_CLOUD_PROJECT is the project ID. GOOGLE_CLOUD_LOCATION: use global.
# GOOGLE_APPLICATION_CREDENTIALS is only needed with a service account file; it holds the file PATH, not its content.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# Meta Muse API key (Standard mode only). Base URL and protocol are set in the experiment config.
META_MUSE_API_KEY=


# Mandatory caps in the declared provider billing unit. A missing cap blocks calls.
# Adaption uses credits; no credit/USD conversion is assumed.
ADAPTION_BUDGET_CREDITS=
VERTEX_BUDGET_USD=
META_MUSE_BUDGET_USD=
